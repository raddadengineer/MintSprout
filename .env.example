# Copy to .env and edit before starting Docker Compose:
#   cp .env.example .env
#
# Docker Compose loads this file automatically for ${VAR} substitutions.

# ─── Required ───────────────────────────────────────────────────────────────

# Signs login tokens (32+ random characters). Never commit the real value.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Must match POSTGRES_PASSWORD below and the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Comma-separated browser origins allowed to call the API (add your domain in production).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ─── Data paths (host directories) ──────────────────────────────────────────
# Bind-mounted into containers. Use absolute paths in production (e.g. /srv/mintsprout/...).

MINTSPROUT_DATA_DIR=./data
MINTSPROUT_POSTGRES_DIR=./data/postgres
MINTSPROUT_LOGS_DIR=./data/logs
MINTSPROUT_BACKUPS_DIR=./data/backups

# ─── Scheduled backups (in-app scheduler) ───────────────────────────────────
# Daily/weekly runs inside MintSprout; configure in Controls → Sprout & App.
# Mount MINTSPROUT_BACKUPS_DIR on the app container (BACKUP_DIR=/app/backups).

BACKUP_SCHEDULE_ENABLED=true
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8

# ─── Profile picker (kiosk mode) ────────────────────────────────────────────

KIOSK_MODE=true
PARENT_PIN=1234
KIOSK_FAMILY_ID=1

# ─── Sprout AI coach (optional) ─────────────────────────────────────────────

AI_COACH_ENABLED=true

# Open WebUI — primary LLM
OPENWEBUI_BASE_URL=https://ai.example.com
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=gemma3:kids

# Ollama — fallback when Open WebUI is not configured
OLLAMA_BASE_URL=http://192.168.1.10:11434
OLLAMA_MODEL=llama3.1:latest

# Kokoro TTS — Sprout voice
KIDS_VOICE_BASE_URL=http://192.168.1.10:8880/v1
KIDS_VOICE_MODEL=kokoro
AI_VOICE_YOUNGEST=af_bella
AI_VOICE_YOUNGER=af_sky
AI_VOICE_OLDER=
